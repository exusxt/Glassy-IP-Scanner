{
  "name": "glassy-ip-scanner",
  "productName": "Glassy IP Scanner",
  "version": "0.1.3",
  "description": "A modern, fast, and lightweight network discovery tool with a glassmorphic interface.",
  "homepage": "https://github.com/exusxt/Glassy-IP-Scanner",
  "main": "./out/main/index.js",
  "author": "Glassy IP Scanner contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:x64": "npm run build && electron-builder --mac --x64",
    "dist:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:x64": "npm run build && electron-builder --linux --x64",
    "dist:linux:arm64": "npm run build && electron-builder --linux --arm64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
